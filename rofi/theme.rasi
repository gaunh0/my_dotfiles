/* =====================================================
   Style: flat/angular (ref style by adi1090x)
   Nền: #0F1219 | Accent: #52ACB8 | Font: JetBrainsMono NF
   ===================================================== */

* {
    font: "JetBrainsMonoNL Nerd Font Mono 12";

    /* Backgrounds */
    bg0:            #0d0d0d;
    bg1:            #141414;
    bg2:            #1e1e1e;

    /* Foregrounds */
    fg0:            #BBC0CA;
    fg1:            #3E4451;

    /* Accents */
    accent-color:   #52ACB8;
    urgent-color:   #E06B75;
    prompt-color:   #60AFEF;

    /* Aliases matching ref variable names */
    background:     #0d0d0d;
    background-alt: #141414;
    foreground:     #BBC0CA;
    selected:       #52ACB8;

    background-color: transparent;
    text-color:       @fg0;

    margin:   0;
    padding:  0;
    spacing:  0;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       950px;

    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               0px;
    border-color:                #4a5a6a;
    background-color:            @background;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     5px;
    margin:                      0px;
    padding:                     5px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @background;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     5px;
    margin:                      0px;
    padding:                     5px;
    border:                      1px solid;
    border-radius:               0px;
    border-color:                @background;
    background-color:            @background;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  @prompt-color;
}

entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "....";
    placeholder-color:           inherit;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       15;

    cycle:                       true;
    dynamic:                     false;
    fixed-height:                false;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-columns:               true;

    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @background;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

scrollbar {
    handle-width:                5px;
    handle-color:                @selected;
    border-radius:               0px;
    background-color:            @background-alt;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     5px;
    margin:                      0px;
    padding:                     5px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @background;
    background-color:            transparent;
    text-color:                  @foreground;
    orientation:                 horizontal;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element normal.urgent {
    background-color:            transparent;
    text-color:                  @urgent-color;
}

element normal.active,
element alternate.active {
    background-color:            transparent;
    text-color:                  @accent-color;
}

element selected.normal {
    border:                      1px solid;
    border-radius:               0px;
    border-color:                @background;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

element selected.urgent {
    background-color:            @urgent-color;
    text-color:                  @background;
}

element selected.active {
    background-color:            @background-alt;
    text-color:                  @accent-color;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Message -----*****/
error-message {
    padding:                     5px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @background;
    background-color:            @background;
    text-color:                  @foreground;
}

textbox {
    background-color:            transparent;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}
